# Copy to frontend/.env (git-ignored). Read at build time by Vite.

# Backend base URL, no trailing slash. Default: http://localhost:8000
# VITE_API_BASE=https://your-backend.example.com

# Cloudflare Turnstile site key (public). Unset -> no bot check widget.
# Must match the backend's TURNSTILE_SECRET_KEY widget.
# VITE_TURNSTILE_SITE_KEY=
