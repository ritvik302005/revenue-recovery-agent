# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit it.

# --- Razorpay (required for the live demo) ------------------------------------
# TEST MODE keys only: Dashboard -> switch to Test Mode -> Settings -> API Keys.
# The backend refuses live keys (rzp_live_...).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# --- CORS ---------------------------------------------------------------------
# Comma-separated frontend origins allowed to call the API.
# Default (unset): http://localhost:5173,http://localhost:3000
# ALLOWED_ORIGINS=https://your-frontend.vercel.app

# --- Storage ------------------------------------------------------------------
# Unset: a local SQLite file (backend/state.db). Fine locally, but most hosts
# wipe the disk on restart, so use Redis (e.g. Upstash, rediss://...) when deployed.
# REDIS_URL=rediss://default:<password>@<host>:6379
# SQLITE_PATH=/path/to/state.db
# LIVE_DEMO_TTL_SECONDS=3600

# --- Access and limits (see docs/ARCHITECTURE.md §3a) --------------------------
# ACCESS_SESSION_TTL_SECONDS=1800
# ORDERS_PER_SESSION=10
# MAX_LIVE_ORDERS_PER_DAY=200
# MAX_LIVE_ORDERS_PER_BATCH=5
# Number of proxies in front of the app whose X-Forwarded-For entries are
# trusted for per-IP rate limits. 0 = use the socket address. Usually 1 behind
# a platform proxy; check the real host's headers before relying on it.
# TRUSTED_PROXY_HOPS=0

# --- Recovery execution (see docs/ARCHITECTURE.md §5) --------------------------
# Wait before a retry_with_delay link becomes payable (shortened for the demo).
# RECOVERY_DELAY_SECONDS=30
# How long a recovery link stays payable before it counts as unpaid.
# RECOVERY_REQUEST_TTL_SECONDS=1800

# --- Razorpay webhooks ---------------------------------------------------------
# Secret of the TEST-MODE webhook you add in the Razorpay Dashboard (Settings ->
# Webhooks), pointing at https://<backend>/api/webhooks/razorpay with events
# payment.failed, payment.captured, order.paid. Not the API key secret.
# Unset: the webhook endpoint answers 503 and the app relies on Checkout's reports.
# RAZORPAY_WEBHOOK_SECRET=

# --- Bot check: Cloudflare Turnstile ------------------------------------------
# Secret key of your Turnstile widget (Cloudflare dashboard -> Turnstile). Set ->
# POST /api/session requires a valid Turnstile token. Unset -> no bot check.
# TURNSTILE_SECRET_KEY=
# Optional: only accept tokens solved on these hostnames (comma-separated).
# TURNSTILE_HOSTNAMES=your-frontend.vercel.app

# --- Evaluation ---------------------------------------------------------------
# Absolute path to the evaluation JSON. Default: backend/evaluation/batch_eval.json
# EVALUATION_PATH=/abs/path/to/batch_eval.json
